<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>birthdayreminder</id>
    <name>Geburtstagserinnerung</name>
    <summary>Erinnerungs- und Glückwunsch-Mails zu Geburtstagen von Vereinsmitgliedern aus einem Nextcloud-Adressbuch.</summary>
    <description><![CDATA[Liest die Geburtstage von Vereinsmitgliedern aus einem gemeinsamen Nextcloud-Adressbuch und verschickt zu frei konfigurierbaren Vorlaufzeiten Erinnerungs-Mails an Verantwortliche sowie eine Glückwunsch-Mail an das Mitglied selbst. Zeigt außerdem die nächsten anstehenden Geburtstage als Dashboard-Widget.]]></description>
    <version>0.2.1</version>
    <licence>agpl</licence>
    <author>Verein</author>
    <namespace>BirthdayReminder</namespace>
    <category>organization</category>
    <bugs>https://example.invalid/issues</bugs>
    <dependencies>
        <nextcloud min-version="28" max-version="34"/>
    </dependencies>
    <!--
    the dashboard widget is added here once M5 lands - referencing a
    not-yet-implemented class would break every request once the app is
    enabled (Application::register runs eagerly on boot).
    -->
    <background-jobs>
        <job>OCA\BirthdayReminder\BackgroundJob\DailyReminderJob</job>
    </background-jobs>
    <commands>
        <command>OCA\BirthdayReminder\Command\DebugUpcoming</command>
        <command>OCA\BirthdayReminder\Command\AddRecipient</command>
        <command>OCA\BirthdayReminder\Command\AddMilestone</command>
    </commands>
    <settings>
        <!--
        admin-delegation (not plain admin/admin-section): lets a real Nextcloud
        admin grant a chosen group (e.g. "Vorstand") access to this settings
        page without giving them full instance-admin rights, see AdminSettings.
        -->
        <admin-delegation>OCA\BirthdayReminder\Settings\AdminSettings</admin-delegation>
        <admin-delegation-section>OCA\BirthdayReminder\Settings\AdminSection</admin-delegation-section>
        <personal>OCA\BirthdayReminder\Settings\PersonalSettings</personal>
        <personal-section>OCA\BirthdayReminder\Settings\PersonalSection</personal-section>
    </settings>
</info>
