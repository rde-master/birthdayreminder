<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>birthdayreminder</id>
    <name>Geburtstagserinnerung</name>
    <summary>Erinnerungs- und Glückwunsch-Mails zu Geburtstagen von Vereinsmitgliedern, verwaltet in einem eigenen Mitgliederregister mit CSV-Import.</summary>
    <description><![CDATA[Eigenes Mitgliederregister (Vorname, Nachname, Geburtsdatum, E-Mail, Deaktiviert-Schalter) mit CSV-Import, der neue Mitglieder anlegt, geänderte aktualisiert und beim Import fehlende automatisch deaktiviert. Verschickt zu frei konfigurierbaren Vorlaufzeiten Erinnerungs-Mails an Verantwortliche sowie eine Glückwunsch-Mail an das Mitglied selbst. Zeigt außerdem die nächsten anstehenden Geburtstage als Dashboard-Widget.]]></description>
    <version>0.5.0</version>
    <licence>agpl</licence>
    <author>Verein</author>
    <namespace>BirthdayReminder</namespace>
    <category>organization</category>
    <bugs>https://example.invalid/issues</bugs>
    <dependencies>
        <nextcloud min-version="28" max-version="34"/>
    </dependencies>
    <background-jobs>
        <job>OCA\BirthdayReminder\BackgroundJob\DailyReminderJob</job>
    </background-jobs>
    <navigations>
        <navigation>
            <name>Geburtstagserinnerung</name>
            <route>birthdayreminder.page.index</route>
            <order>50</order>
        </navigation>
    </navigations>
    <commands>
        <command>OCA\BirthdayReminder\Command\DebugUpcoming</command>
        <command>OCA\BirthdayReminder\Command\AddRecipient</command>
        <command>OCA\BirthdayReminder\Command\AddMilestone</command>
    </commands>
    <settings>
        <!--
        Plain <admin>/<admin-section> - NOT <admin-delegation>: that tag is
        for registering a delegatable permission with no settings page of its
        own (see apps/webhook_listeners for that pattern). A real, visible
        settings page that also supports delegation (like apps/dav's
        CalDAVSettings) is registered as a normal <admin> setting while the
        class implements IDelegatedSettings - that's what makes it show up
        in the standard Administration nav for full admins immediately, and
        become delegatable to a chosen group (e.g. "Vorstand") via
        Settings -> Administration -> Delegation / `occ admin-delegation:add`.
        -->
        <admin>OCA\BirthdayReminder\Settings\AdminSettings</admin>
        <admin-section>OCA\BirthdayReminder\Settings\AdminSection</admin-section>
        <personal>OCA\BirthdayReminder\Settings\PersonalSettings</personal>
        <personal-section>OCA\BirthdayReminder\Settings\PersonalSection</personal-section>
    </settings>
</info>
